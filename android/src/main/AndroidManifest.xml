<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.sygic.fleet" />
        <package android:name="com.sygic.truck" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="com.sygic.aura" />
        </intent>
    </queries>

    <application>
        <provider
            android:name=".SygicRouteContentProvider"
            android:authorities="${applicationId}.sygic_route_provider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
